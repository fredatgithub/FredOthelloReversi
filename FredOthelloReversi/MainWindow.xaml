<Window x:Class="FredOthelloReversi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Othello | Reversi" Height="820" Width="1120"
        MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#101B19"
        Foreground="#F3F4EC"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#1B2926"/>
            <Setter Property="BorderBrush" Value="#2B3B36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F3F4EC"/>
            <Setter Property="Background" Value="#28755D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#348D70"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="34,24,34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="OTHELLO" FontSize="13" FontWeight="Bold"
                           Foreground="#76C9A7"/>
                <TextBlock Text="Reversi" FontSize="32" FontWeight="SemiBold"
                           Margin="0,2,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#1B2926" CornerRadius="20" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#76C9A7" Margin="0,0,8,0"/>
                    <TextBlock Text="PARTIE EN COURS" FontSize="11" FontWeight="Bold"
                               Foreground="#B8C8C0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#163F35" CornerRadius="18"
                    Padding="14" Margin="0,0,24,0">
                <Viewbox Stretch="Uniform">
                    <Grid x:Name="BoardGrid" Width="640" Height="640" ClipToBounds="True"/>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SCORE" FontSize="12" FontWeight="Bold"
                                   Foreground="#91A69C"
                                   Margin="0,0,0,18"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="22" Height="22" Fill="#101312"
                                         Stroke="#53605B" StrokeThickness="1" Margin="0,0,11,0"/>
                                <StackPanel>
                                    <TextBlock Text="VOUS" FontSize="11" FontWeight="Bold"
                                               Foreground="#91A69C"/>
                                    <TextBlock Text="Noir" FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="PlayerScoreText" Grid.Column="1" Text="2"
                                       FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="#2B3B36" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="22" Height="22" Fill="#F0F1E9"
                                         Stroke="#AEB7B0" StrokeThickness="1" Margin="0,0,11,0"/>
                                <StackPanel>
                                    <TextBlock Text="ORDINATEUR" FontSize="11" FontWeight="Bold"
                                               Foreground="#91A69C"/>
                                    <TextBlock Text="Blanc" FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="ComputerScoreText" Grid.Column="1" Text="2"
                                       FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="À VOUS DE JOUER" x:Name="TurnLabel"
                                   FontSize="11" FontWeight="Bold" Foreground="#76C9A7"/>
                        <TextBlock x:Name="StatusText" Text="Choisissez une case illuminée."
                                   FontSize="15" TextWrapping="Wrap" LineHeight="23"
                                   Margin="0,9,0,0"/>
                        <Border Background="#243732" CornerRadius="9" Padding="11,9"
                                Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#E8B96E" Margin="0,0,8,0"/>
                                <TextBlock x:Name="MovesText" Text="0 cases jouées"
                                           FontSize="12" Foreground="#B8C8C0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Button Content="Nouvelle partie" Click="NewGame_Click"
                        Style="{StaticResource ActionButton}" Height="48"/>
                <TextBlock Text="Retournez les pions adverses en les&#10;encadrant. Les coins sont précieux."
                           FontSize="12" Foreground="#91A69C" LineHeight="19"
                           TextWrapping="Wrap" Margin="2,18,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
